{
  "entities": {
    "Settings": {
      "title": "Settings",
      "description": "User business and follow-up configuration",
      "type": "object",
      "properties": {
        "negocio": { "type": "string", "maxLength": 128 },
        "telefono": { "type": "string", "maxLength": 32 },
        "iva": { "type": "number" },
        "dias": { "type": "array" },
        "condiciones": { "type": "string", "maxLength": 2048 }
      },
      "required": ["negocio", "iva", "dias"]
    },
    "Quote": {
      "title": "Quote",
      "description": "Commercial proposal and quote document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "num": { "type": "string", "maxLength": 32 },
        "cliente": { "type": "string", "maxLength": 128 },
        "telefono": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "titulo": { "type": "string", "maxLength": 256 },
        "estado": { "type": "string", "enum": ["borrador", "enviado", "aceptado", "rechazado", "cancelado"] },
        "emision": { "type": "string", "maxLength": 10 },
        "validez": { "type": "string", "maxLength": 10 },
        "enviado": { "type": "string" },
        "pausa": { "type": "boolean" },
        "resuelto": { "type": "string" },
        "motivo": { "type": "string" },
        "nota": { "type": "string" },
        "notas": { "type": "string" },
        "condiciones": { "type": "string" },
        "lineas": { "type": "array" },
        "seg": { "type": "array" },
        "hist": { "type": "array" }
      },
      "required": ["id", "num", "cliente", "titulo", "estado", "lineas"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with 14-day trial and subscription details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" },
        "trialStartedAt": { "type": "string" },
        "trialEndsAt": { "type": "string" },
        "trialStatus": { "type": "string", "enum": ["active", "expired"] },
        "subscriptionStatus": { "type": "string", "enum": ["none", "active", "canceled", "past_due"] },
        "planId": { "type": "string" }
      },
      "required": ["userId", "trialStartedAt", "trialEndsAt", "trialStatus", "subscriptionStatus"]
    },
    "SurveyResponse": {
      "title": "SurveyResponse",
      "description": "21-day user product validation survey response",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "userCreatedAt": { "type": "string" },
        "submittedAt": { "type": "string" },
        "surveyVersion": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["completed"] },
        "answers": { "type": "object" }
      },
      "required": ["id", "userId", "submittedAt", "surveyVersion", "status", "answers"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Designated administrator identity record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["userId", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile, trial duration and subscription status"
    },
    "/users/{userId}/settings/config": {
      "schema": "Settings",
      "description": "User business configuration and defaults"
    },
    "/users/{userId}/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "User commercial quotes and proposals"
    },
    "/survey_responses/{responseId}": {
      "schema": "SurveyResponse",
      "description": "21-day product validation survey responses"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized administrators who can view survey responses and metrics"
    }
  }
}
