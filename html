<script>
(function(){
'use strict';
var KEY='presufollow.v0';
var MOTIVOS=['Precio','Plazo','Ha elegido otra alternativa','Ya no necesita el servicio','Otro motivo'];
var IVAS=[21,10,4,0];

//<calc>
function num(v){var n=parseFloat(String(v==null?'':v).replace(',','.'));return isFinite(n)?n:0;}
function rnd(x){return Math.round(x+(x<0?-1e-9:1e-9));}
function clampDisc(v){return Math.min(100,Math.max(0,num(v)));}
function lineBase(l){return rnd(num(l.qty)*num(l.price)*100);}
function lineTotal(l){var b=lineBase(l);return b-rnd(b*clampDisc(l.disc)/100);}
function calc(lineas){
  var bruto=0,desc=0,g={};
  lineas.forEach(function(l){
    var b=lineBase(l),dd=rnd(b*clampDisc(l.disc)/100),k=num(l.iva);
    bruto+=b;desc+=dd;g[k]=(g[k]||0)+b-dd;
  });
  var ivas=Object.keys(g).map(Number).sort(function(a,b){return b-a;}).map(function(k){return{rate:k,base:g[k],cuota:rnd(g[k]*k/100)};});
  var imp=ivas.reduce(function(s,x){return s+x.cuota;},0);
  var base=bruto-desc;
  return{bruto:bruto,desc:desc,base:base,ivas:ivas,imp:imp,total:base+imp};
}
function pad(n){return String(n).padStart(2,'0');}
function iso(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());}
function today(){return iso(new Date());}
function parseD(s){var p=s.split('-').map(Number);return new Date(p[0],p[1]-1,p[2]);}
function addDays(s,n){var d=parseD(s);d.setDate(d.getDate()+n);return iso(d);}
function diffDays(a,b){return Math.round((parseD(a)-parseD(b))/86400000);}
//</calc>

function fmt(c){return new Intl.NumberFormat('es-ES',{style:'currency',currency:'EUR'}).format(c/100);}
function fdate(s){return s?parseD(s.slice(0,10)).toLocaleDateString('es-ES',{day:'numeric',month:'short',year:'numeric'}):'—';}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function $(s,r){return (r||document).querySelector(s);}
function uid(){return 'q'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);}
function firstName(n){return String(n||'').trim().split(/\s+/)[0]||'';}
function plural(n,a,b){return n===1?a:b;}

/* ---------- datos ---------- */
function nextNum(st){
  var y=new Date().getFullYear(),re=new RegExp('^PF-'+y+'-(\\d+)$'),mx=0;
  st.quotes.forEach(function(q){var m=re.exec(q.num);if(m)mx=Math.max(mx,parseInt(m[1],10));});
  return 'PF-'+y+'-'+String(mx+1).padStart(4,'0');
}
function seed(){
  var t=today();
  function ago(n){return addDays(t,-n);}
  var s={v:1,settings:{negocio:'Instalaciones Demo',telefono:'',iva:21,dias:[3,7,14],condiciones:'Forma de pago: 50 % al aceptar y 50 % al terminar el trabajo.'},quotes:[]};
  function L(desc,qty,price,disc,iva){return{desc:desc,qty:String(qty),price:String(price),disc:disc?String(disc):'',iva:String(iva==null?21:iva)};}
  function add(o){
    var sent=o.sentAgo!=null;
    var q={id:uid(),num:nextNum(s),example:true,pausa:false,resuelto:null,motivo:'',nota:'',notas:'',
      condiciones:s.settings.condiciones,cliente:o.cliente,telefono:o.tel||'',email:o.email||'',titulo:o.titulo,lineas:o.lineas,
      estado:o.estado,emision:sent?ago(o.sentAgo):t,validez:addDays(sent?ago(o.sentAgo):t,o.valid||30),
      enviado:sent?ago(o.sentAgo):null,seg:[],hist:[]};
    if(sent){
      q.hist.push({f:q.enviado+'T09:00',t:'Presupuesto marcado como enviado'});
      q.seg=s.settings.dias.map(function(d,i){
        var done=i<(o.fu||0)?addDays(q.enviado,d):null;
        if(done)q.hist.push({f:done+'T10:00',t:'Recordatorio '+(i+1)+' enviado'});
        return{dia:d,hecho:done};
      });
    }else q.hist.push({f:t+'T09:00',t:'Borrador creado'});
    if(o.res){q.resuelto=ago(o.res);q.motivo=o.motivo||'';q.hist.push({f:q.resuelto+'T12:00',t:o.estado==='aceptado'?'El cliente aceptó el presupuesto':'El cliente rechazó el presupuesto'+(o.motivo?' ('+o.motivo+')':'')});}
    q.hist.sort(function(a,b){return a.f<b.f?-1:1;});
    s.quotes.unshift(q);
  }
  add({cliente:'Ona Bosch',tel:'600 100 200',titulo:'Reparación de tejado',estado:'rechazado',sentAgo:25,fu:2,res:18,motivo:'Precio',
    lineas:[L('Retirada de tejas rotas',1,380),L('Impermeabilización de 40 m²',40,38),L('Tejas nuevas y colocación',1,640)]});
  add({cliente:'Marc Vila',tel:'600 100 300',titulo:'Instalación de toldo en terraza',estado:'enviado',sentAgo:16,valid:30,fu:3,
    lineas:[L('Toldo de brazos extensibles 4 × 3 m',1,1480),L('Motor y mando a distancia',1,260),L('Instalación',1,190)]});
  add({cliente:'Carles Puig',tel:'600 100 400',titulo:'Persianas y mosquiteras',estado:'enviado',sentAgo:20,valid:15,fu:3,
    lineas:[L('Persiana de aluminio',4,185),L('Mosquitera enrollable',4,92,5)]});
  add({cliente:'Joan Mas',tel:'600 100 500',titulo:'Cambio de caldera de gas',estado:'aceptado',sentAgo:12,fu:1,res:6,
    lineas:[L('Caldera de condensación 24 kW',1,1650,5),L('Desmontaje y retirada de la anterior',1,120),L('Instalación y puesta en marcha',1,340)]});
  add({cliente:'Laura Vidal',tel:'600 100 600',titulo:'Pintura de piso de 90 m²',estado:'enviado',sentAgo:1,fu:0,
    lineas:[L('Pintura plástica en paredes y techos (m²)',240,6.5),L('Protección de suelos y muebles',1,150),L('Reparación de grietas y lijado',1,210)]});
  add({cliente:'Pau Ribas',tel:'600 100 700',titulo:'Instalación eléctrica de garaje',estado:'enviado',sentAgo:8,fu:1,
    lineas:[L('Cuadro eléctrico con 6 circuitos',1,420),L('Cableado y canalización (m)',45,9.5),L('Puntos de luz y enchufes',8,38),L('Legalización y boletín',1,180)]});
  add({cliente:'Marta Soler',tel:'600 100 800',email:'marta@ejemplo.es',titulo:'Reforma completa de baño',estado:'enviado',sentAgo:3,fu:0,
    lineas:[L('Demolición y retirada de escombros',1,480),L('Alicatado de paredes (m²)',18,42),L('Plato de ducha y mampara',1,690,5),L('Fontanería y desagües',1,520)]});
  add({cliente:'Núria Pons',tel:'600 100 900',titulo:'Aire acondicionado en salón',estado:'borrador',
    lineas:[L('Equipo split 3.000 frigorías',1,780),L('Instalación con 4 m de tubería',1,260)]});
  return s;
}
function load(){
  try{var r=localStorage.getItem(KEY);if(r){var s=JSON.parse(r);if(s&&s.quotes&&s.settings)return s;}}catch(e){}
  return seed();
}
var S=load();
var view={n:'hoy',id:null};
var ed=null;
var ui={filter:'todos',q:'',period:'todo',confirm:null,resolving:null,msg:'',msgKey:'',saveErr:false};
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));ui.saveErr=false;}catch(e){ui.saveErr=true;}}
save();

function byId(id){return S.quotes.find(function(q){return q.id===id;});}
function qTotal(q){return calc(q.lineas).total;}
function hist(q,t){q.hist.push({f:today()+'T'+pad(new Date().getHours())+':'+pad(new Date().getMinutes()),t:t});}
function isVencido(q){return q.estado==='enviado'&&!!q.validez&&q.validez<today();}
function nextFu(q){
  if(q.estado!=='enviado'||q.pausa)return null;
  var i=q.seg.findIndex(function(s){return !s.hecho;});
  if(i<0)return null;
  return{i:i,due:addDays(q.enviado,q.seg[i].dia),dia:q.seg[i].dia};
}
function status(q){
  if(q.estado==='enviado'){
    if(isVencido(q))return['vencido','Vencido'];
    if(q.pausa)return['pausa','Seguimiento en pausa'];
    return['enviado','Pendiente de respuesta'];
  }
  return[q.estado,{borrador:'Borrador',aceptado:'Aceptado',rechazado:'Rechazado',cancelado:'Cancelado'}[q.estado]];
