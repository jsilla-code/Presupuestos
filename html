    (q.notas?'<p class="hint" style="margin-top:10px"><strong>Nota interna:</strong> '+esc(q.notas)+'</p>':'');

  var side='';
  side+='<section class="panel"><div class="btnrow" style="justify-content:space-between"><span style="font-weight:600">Estado</span>'+chip(q)+'</div>';
  if(q.estado==='enviado'){
    side+='<p class="hint">Enviado el '+fdate(q.enviado)+'.'+(isVencido(q)?' Venció el '+fdate(q.validez)+' y no recibirá más recordatorios.':'')+'</p>'+
      '<ul class="steps">'+q.seg.map(function(s,i){return '<li><span>Recordatorio '+(i+1)+' · día '+s.dia+'</span><span>'+(s.hecho?'<strong>Enviado</strong> el '+fdate(s.hecho):fdate(addDays(q.enviado,s.dia)))+'</span></li>';}).join('')+'</ul>';
  }
  if(q.estado==='aceptado'||q.estado==='rechazado')side+='<p class="hint">'+(q.estado==='aceptado'?'Aceptado':'Rechazado')+' el '+fdate(q.resuelto)+(q.motivo?'. Motivo: '+esc(q.motivo):'')+(q.nota?'. '+esc(q.nota):'')+'.</p>';
  var b='';
  if(q.estado==='enviado'){
    b+='<button class="btn btn-ok sm" data-a="resolve" data-k="aceptado">El cliente aceptó</button><button class="btn btn-bad sm" data-a="resolve" data-k="rechazado">El cliente rechazó</button>';
    b+=q.pausa?'<button class="btn sm" data-a="resume">Reanudar seguimientos</button>':'<button class="btn sm" data-a="pause">Pausar seguimientos</button>';
  }
  if(q.estado==='borrador')b+='<button class="btn sm" data-a="edit" data-id="'+q.id+'">Editar</button>';
  b+='<button class="btn sm" data-a="dup" data-id="'+q.id+'">Duplicar</button>';
  if(q.estado==='enviado'||q.estado==='borrador'){
    b+=ui.confirm==='cancel'?'<button class="btn btn-bad sm" data-a="cancelok">Confirmar cancelación</button>':'<button class="btn btn-quiet sm" data-a="cancel">Cancelar presupuesto</button>';
  }
  if(q.estado==='borrador')b+=ui.confirm==='del'?'<button class="btn btn-bad sm" data-a="delok">Confirmar eliminar</button>':'<button class="btn btn-quiet sm" data-a="del">Eliminar</button>';
  side+='<div class="btnrow">'+b+'</div>';
  if(ui.resolving==='aceptado')side+='<div class="f"><label for="res-nota">Nota (opcional)</label><input id="res-nota" placeholder="Ej.: empezamos el día 3"></div><button class="btn btn-ok" data-a="resok" data-k="aceptado">Confirmar aceptación</button>';
  if(ui.resolving==='rechazado')side+='<div class="f"><label for="res-motivo">Motivo</label><select id="res-motivo">'+MOTIVOS.map(function(m){return '<option>'+m+'</option>';}).join('')+'</select></div><div class="f"><label for="res-nota">Nota (opcional)</label><input id="res-nota"></div><button class="btn btn-bad" data-a="resok" data-k="rechazado">Confirmar rechazo</button>';
  if(q.estado==='enviado'&&isVencido(q))side+='<p class="hint">Para reactivarlo, duplícalo como nueva versión con fechas actualizadas y envíalo de nuevo.</p>';
  side+='</section>'+msgPanel(q);
  side+='<section class="panel"><h3>Historial</h3><ul class="hist">'+q.hist.slice().reverse().map(function(h){return '<li><time>'+esc(fdate(h.f))+'</time><span>'+esc(h.t)+'</span></li>';}).join('')+'</ul></section>';
  return '<div class="back"><button class="btn btn-quiet sm" data-a="go" data-n="lista">← Presupuestos</button></div><div class="detail"><div style="min-width:0">'+doc+'</div><div class="stack" style="gap:14px;min-width:0">'+side+'</div></div>';
}

/* --- estadísticas --- */
function vStats(){
  var t=today(),from=null;
  if(ui.period==='mes')from=t.slice(0,8)+'01';
  if(ui.period==='anio')from=t.slice(0,4)+'-01-01';
  var sent=S.quotes.filter(function(q){return q.enviado&&(!from||q.enviado>=from);});
  var A=[],R=[],P=[],V=[],C=[],tot=0,fu=0;
  sent.forEach(function(q){
    tot+=qTotal(q);fu+=q.seg.filter(function(s){return s.hecho;}).length;
    if(q.estado==='aceptado')A.push(q);else if(q.estado==='rechazado')R.push(q);else if(q.estado==='cancelado')C.push(q);else if(isVencido(q))V.push(q);else P.push(q);
  });
  function sum(a){return a.reduce(function(s,q){return s+qTotal(q);},0);}
  var decided=A.length+R.length,rate=decided?Math.round(A.length/decided*100)+' %':'—';
  var res=A.concat(R).filter(function(q){return q.resuelto;}),avg=res.length?(res.reduce(function(s,q){return s+diffDays(q.resuelto,q.enviado);},0)/res.length).toFixed(1).replace('.',',')+' días':'—';
  var pend=P.concat(V),totalBar=sum(A)+sum(pend)+sum(R)||1;
  function w(v){return (v/totalBar*100).toFixed(1)+'%';}
  var mot={};R.forEach(function(q){var m=q.motivo||'Sin indicar';mot[m]=(mot[m]||0)+1;});
  var per=[['todo','Todo'],['anio','Este año'],['mes','Este mes']];
  return '<div class="sec-h"><h2>Estadísticas</h2><div class="filters" style="margin:0" role="group" aria-label="Periodo">'+per.map(function(p){return '<button class="fchip" data-a="period" data-p="'+p[0]+'" aria-pressed="'+(ui.period===p[0])+'">'+p[1]+'</button>';}).join('')+'</div></div>'+
    (!sent.length?'<div class="empty">Aún no hay presupuestos enviados en este periodo.</div>':
    '<div class="stack"><section><div class="bar" role="img" aria-label="Reparto del importe presupuestado"><i style="width:'+w(sum(A))+';background:var(--ok)"></i><i style="width:'+w(sum(pend))+';background:var(--accent)"></i><i style="width:'+w(sum(R))+';background:var(--bad)"></i></div>'+
    '<div class="legend num"><span style="--c:var(--ok)">Aceptado '+fmt(sum(A))+'</span><span style="--c:var(--accent)">Pendiente o vencido '+fmt(sum(pend))+'</span><span style="--c:var(--bad)">Rechazado '+fmt(sum(R))+'</span></div>'+
    '<p class="hint" style="margin-top:6px">Son importes presupuestados. Un presupuesto aceptado no es dinero cobrado.</p></section>'+
    '<div class="kv"><div><span>Presupuestos enviados</span><span class="num">'+sent.length+'</span></div><div><span>Importe enviado</span><span class="num">'+fmt(tot)+'</span></div>'+
    '<div><span>Aceptados</span><span class="num">'+A.length+'</span></div><div><span>Rechazados</span><span class="num">'+R.length+'</span></div>'+
    '<div><span>Pendientes</span><span class="num">'+P.length+'</span></div><div><span>Vencidos</span><span class="num">'+V.length+'</span></div>'+
    '<div><span>Tasa de aceptación</span><span class="num">'+rate+'</span></div><div><span>Tiempo medio hasta respuesta</span><span class="num">'+avg+'</span></div>'+
    '<div><span>Recordatorios enviados</span><span class="num">'+fu+'</span></div><div><span>Cancelados</span><span class="num">'+C.length+'</span></div></div>'+
    '<p class="hint">Tasa de aceptación = aceptados ÷ (aceptados + rechazados). Los pendientes y vencidos no cuentan hasta que haya respuesta.</p>'+
    (R.length?'<section><div class="sec-h"><h3>Por qué rechazan</h3></div><div class="kv">'+Object.keys(mot).map(function(m){return '<div><span>'+esc(m)+'</span><span class="num">'+mot[m]+'</span></div>';}).join('')+'</div></section>':'')+'</div>');
}

/* --- ajustes --- */
function vAjustes(){
  var s=S.settings;
  return '<div class="sec-h"><h2>Ajustes</h2></div><div class="stack">'+
    '<section class="card"><h3>Tu negocio</h3><div class="grid">'+
    '<div class="f"><label for="s-negocio">Nombre del negocio</label><input id="s-negocio" data-s="negocio" value="'+esc(s.negocio)+'"></div>'+
    '<div class="f"><label for="s-tel">Teléfono de contacto</label><input id="s-tel" data-s="telefono" inputmode="tel" value="'+esc(s.telefono)+'"></div>'+
    '<div class="f"><label for="s-iva">IVA por defecto en líneas nuevas</label><select id="s-iva" data-s="iva">'+IVAS.map(function(r){return '<option value="'+r+'"'+(r===Number(s.iva)?' selected':'')+'>'+r+' %</option>';}).join('')+'</select></div>'+
    '<div class="f full"><label for="s-cond">Condiciones habituales</label><textarea id="s-cond" data-s="condiciones" rows="3">'+esc(s.condiciones)+'</textarea></div></div>'+
    '<p class="hint" style="margin-top:10px">Elige tú el tipo de IVA que corresponde a cada trabajo. La aplicación no comprueba la normativa fiscal.</p></section>'+
    '<section class="card"><h3>Días de seguimiento</h3><p class="hint" style="margin-bottom:10px">Días desde el envío hasta cada recordatorio. Se aplican a los presupuestos que envíes a partir de ahora.</p><div class="grid">'+
    [0,1,2].map(function(i){return '<div class="f"><label for="s-d'+i+'">Recordatorio '+(i+1)+'</label><input id="s-d'+i+'" data-s="dia" data-i="'+i+'" inputmode="numeric" value="'+s.dias[i]+'"></div>';}).join('')+'</div></section>'+
    '<section class="card"><h3>Copia de seguridad</h3><p class="hint" style="margin-bottom:10px">Copia este texto y guárdalo en un lugar seguro. Para restaurar, pégalo abajo.</p>'+
    '<div class="f"><label for="bk-out">Tus datos</label><textarea id="bk-out" rows="4" readonly>'+esc(JSON.stringify(S))+'</textarea></div>'+
    '<div class="btnrow" style="margin:8px 0 14px"><button class="btn" data-a="exportcopy">Copiar copia de seguridad</button></div>'+
    '<div class="f"><label for="bk-in">Restaurar desde una copia</label><textarea id="bk-in" rows="3" placeholder="Pega aquí la copia"></textarea></div>'+
    '<div class="btnrow" style="margin-top:8px">'+(ui.confirm==='import'?'<button class="btn btn-bad" data-a="importok">Confirmar: reemplaza todos los datos actuales</button>':'<button class="btn" data-a="import">Restaurar</button>')+'</div></section>'+
    '<section class="card"><h3>Qué no hace todavía esta versión</h3><ul class="todo-list"><li>No genera PDF ni un enlace público para que el cliente acepte o rechace.</li><li>No envía correos ni mensajes por sí sola: tú los envías y lo marcas.</li><li>No avisa fuera de la aplicación; hay que abrirla cada día.</li><li>Los datos viven en un solo navegador.</li></ul></section></div>';
}

/* ---------- acciones ---------- */
function copyText(t,okMsg){
  var p=navigator.clipboard&&navigator.clipboard.writeText?navigator.clipboard.writeText(t):Promise.reject();
  p.then(function(){toast(okMsg||'Copiado');},function(){
    var ta=$('#msgtxt')||$('#bk-out');
    if(ta){ta.focus();ta.select();toast('Selecciona y copia el texto manualmente');}
    else toast('No se pudo copiar. Abre el presupuesto para copiar el texto.');
  });
}
function dupQuote(q){
  var n={id:uid(),num:nextNum(S),example:false,estado:'borrador',pausa:false,enviado:null,seg:[],resuelto:null,motivo:'',nota:'',hist:[],
    cliente:q.cliente,telefono:q.telefono,email:q.email,titulo:q.titulo,emision:today(),validez:addDays(today(),30),
    condiciones:q.condiciones,notas:q.notas,lineas:q.lineas.map(function(l){return Object.assign({},l);})};
  hist(n,'Duplicado de '+q.num);S.quotes.unshift(n);save();return n;
}
function updateMsgLinks(){
  var q=byId(view.id);if(!q)return;
  var wa=$('#wa');if(wa)wa.href=waUrl(q.telefono,ui.msg);
  var m=$('#mail');if(m){var n=nextFu(q);m.href=mailUrl(q,q.estado==='borrador'?initSubject(q):fuSubject(q,n?n.i:2),ui.msg);}
}
function act(a,el){
  var id=el.dataset.id,q=id?byId(id):byId(view.id),i=el.dataset.i;
  switch(a){
    case 'go':go(el.dataset.n);break;
    case 'new':ed=newEd();go('edit');break;
    case 'open':go('det',id);break;
    case 'edit':ed=Object.assign({},q,{lineas:q.lineas.map(function(l){return Object.assign({},l);})});go('edit');break;
    case 'edcancel':ed=null;go(view.id?'det':'lista',view.id);break;
    case 'dup':{var n=dupQuote(q);ed=Object.assign({},n,{lineas:n.lineas.map(function(l){return Object.assign({},l);})});toast('Duplicado como borrador');go('edit');break;}
    case 'del':ui.confirm='del';render();break;
    case 'delok':S.quotes=S.quotes.filter(function(x){return x.id!==q.id;});save();toast('Borrador eliminado');go('lista');break;
    case 'cancel':ui.confirm='cancel';render();break;
    case 'cancelok':q.estado='cancelado';hist(q,'Presupuesto cancelado');ui.confirm=null;save();toast('Presupuesto cancelado');render();break;
    case 'send':q.estado='enviado';q.enviado=today();q.seg=S.settings.dias.map(function(d){return{dia:d,hecho:null};});hist(q,'Presupuesto marcado como enviado');save();ui.msgKey='';toast('Marcado como enviado. Te avisaré de los seguimientos.');render();break;
    case 'fudone':q.seg[Number(i)].hecho=today();hist(q,'Recordatorio '+(Number(i)+1)+' enviado');save();ui.msgKey='';toast('Recordatorio registrado');render();break;
    case 'copyfu':copyText(fuMsg(q,Number(i)),'Mensaje copiado');break;
    case 'copymsg':copyText(ui.msg,'Mensaje copiado');break;
    case 'copysubj':copyText(el.dataset.s,'Asunto copiado');break;
    case 'pause':q.pausa=true;hist(q,'Seguimientos pausados');save();render();break;
    case 'resume':q.pausa=false;hist(q,'Seguimientos reanudados');save();render();break;
    case 'resolve':ui.resolving=el.dataset.k;render();break;
    case 'resok':{
      var k=el.dataset.k,nota=($('#res-nota')||{}).value||'',mo=($('#res-motivo')||{}).value||'';
      q.estado=k;q.resuelto=today();q.motivo=k==='rechazado'?mo:'';q.nota=nota.trim();
      hist(q,k==='aceptado'?'El cliente aceptó el presupuesto':'El cliente rechazó el presupuesto'+(mo?' ('+mo+')':''));
      ui.resolving=null;save();toast(k==='aceptado'?'Presupuesto aceptado':'Presupuesto rechazado');render();break;}
    case 'filter':ui.filter=el.dataset.f;render();break;
    case 'period':ui.period=el.dataset.p;render();break;
    case 'addline':ed.lineas.push(blankLine());drawLines();var li=$('#l-desc-'+(ed.lineas.length-1));if(li)li.focus();break;
    case 'dupline':ed.lineas.splice(Number(i)+1,0,Object.assign({},ed.lineas[Number(i)]));drawLines();break;
    case 'rmline':if(ed.lineas.length>1)ed.lineas.splice(Number(i),1);else ed.lineas=[blankLine()];drawLines();break;
    case 'save':saveEd(false);break;
    case 'saveSend':saveEd(true);break;
    case 'clearEx':S.quotes=S.quotes.filter(function(x){return !x.example;});save();toast('Ejemplos borrados');if(view.n==='det'&&!byId(view.id))go('hoy');else render();break;
    case 'exportcopy':copyText(JSON.stringify(S),'Copia de seguridad copiada');break;
    case 'import':ui.confirm='import';render();break;
    case 'importok':{
      try{var d=JSON.parse(($('#bk-in')||{}).value||'');if(!d||!Array.isArray(d.quotes)||!d.settings)throw 0;S=d;save();ui.confirm=null;toast('Copia restaurada');go('hoy');}
      catch(e){ui.confirm=null;render();toast('El texto no es una copia válida');}
      break;}
  }
}

app.addEventListener('click',function(e){var el=e.target.closest('[data-a]');if(el)act(el.dataset.a,el);});
app.addEventListener('input',function(e){
  var t=e.target;
  if(t.dataset.f==='msg'){ui.msg=t.value;updateMsgLinks();return;}
  if(t.id==='q-search'){ui.q=t.value;$('#qlist').innerHTML=listRows();return;}
  if(view.n==='edit'&&ed){
    if(t.dataset.f){ed[t.dataset.f]=t.value;return;}
    if(t.dataset.l){ed.lineas[Number(t.dataset.i)][t.dataset.l]=t.value;updateTotals();}
  }
});
app.addEventListener('change',function(e){
  var t=e.target;
  if(view.n==='edit'&&ed&&t.id==='f-cliente'){
    var m=S.quotes.find(function(q){return q.cliente.toLowerCase()===t.value.trim().toLowerCase();});
    if(m){
      if(!ed.telefono&&m.telefono){ed.telefono=m.telefono;$('#f-telefono').value=m.telefono;}
      if(!ed.email&&m.email){ed.email=m.email;$('#f-email').value=m.email;}
    }
  }
  if(view.n==='ajustes'&&t.dataset.s){
    var k=t.dataset.s;
    if(k==='dia'){
      var v=parseInt(t.value,10);
      if(!(v>=1&&v<=90)){t.value=S.settings.dias[Number(t.dataset.i)];toast('Introduce un número de días entre 1 y 90');return;}
      var d=S.settings.dias.slice();d[Number(t.dataset.i)]=v;S.settings.dias=d.slice().sort(function(a,b){return a-b;});
      d=S.settings.dias;[0,1,2].forEach(function(j){$('#s-d'+j).value=d[j];});
    }else S.settings[k]=k==='iva'?Number(t.value):t.value;
    save();toast('Guardado');
  }
});

render();
})();
</script>

</body></html>
