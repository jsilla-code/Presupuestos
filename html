var app=$('#app');
function go(n,id){view={n:n,id:id||null};ui.confirm=null;ui.resolving=null;ui.msgKey='';render();window.scrollTo(0,0);}
function toast(t){var el=$('#toast');el.textContent=t;el.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(function(){el.hidden=true;},2400);}

function hoyData(){
  var t=today(),r={due:[],soon:[],venc:[],ended:[],pend:0,pendAmt:0};
  S.quotes.forEach(function(q){
    if(q.estado!=='enviado')return;
    r.pend++;r.pendAmt+=qTotal(q);
    if(isVencido(q)){r.venc.push(q);return;}
    if(q.pausa)return;
    var n=nextFu(q);
    if(!n){r.ended.push(q);return;}
    var o={q:q,i:n.i,due:n.due,dia:n.dia};
    (n.due<=t?r.due:r.soon).push(o);
  });
  r.due.sort(function(a,b){return a.due<b.due?-1:1;});
  r.soon.sort(function(a,b){return a.due<b.due?-1:1;});
  return r;
}

