function listRows(){
  var q=ui.q.trim().toLowerCase(),rows=S.quotes.filter(function(x){
    var k=status(x)[0],f=ui.filter;
    var okF=f==='todos'||(f==='pendientes'&&k==='enviado')||(f==='pendientes'&&k==='pausa')||k===f.replace(/s$/,'')&&f!=='pendientes'&&f!=='todos';
    if(f==='borradores')okF=k==='borrador';
    if(f==='aceptados')okF=k==='aceptado';
    if(f==='rechazados')okF=k==='rechazado';
    if(f==='vencidos')okF=k==='vencido';
    var okQ=!q||x.num.toLowerCase().indexOf(q)>=0||x.cliente.toLowerCase().indexOf(q)>=0||x.titulo.toLowerCase().indexOf(q)>=0;
    return okF&&okQ;
  });
  if(!rows.length)return '<div class="empty">No hay presupuestos con este filtro.</div>';
  return '<div class="list">'+rows.map(function(x){
    var n=nextFu(x),extra=n&&!isVencido(x)?dueText(n.due):(x.enviado?'Enviado el '+fdate(x.enviado):'Creado el '+fdate(x.emision));
    return simpleItem(x,extra);
  }).join('')+'</div>';
}
