function saveEd(andSend){
  var e=ed,errs=[];
  if(!e.cliente.trim())errs.push('Escribe el nombre del cliente.');
  if(!e.titulo.trim())errs.push('Describe el trabajo en una línea.');
  if(e.email.trim()&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e.email.trim()))errs.push('El correo no parece válido.');
  var lines=e.lineas.filter(function(l){return l.desc.trim();});
  if(!lines.some(function(l){return num(l.price)>0;}))errs.push('Añade al menos un concepto con descripción y precio.');
  if(e.validez&&e.emision&&e.validez<e.emision)errs.push('La fecha de validez es anterior a la de emisión.');
  if(errs.length){var box=$('#errs');box.innerHTML=errs.map(function(x){return '<p>'+esc(x)+'</p>';}).join('');box.scrollIntoView({block:'center'});return;}
  var q;
  if(e.id){q=byId(e.id);hist(q,'Borrador editado');}
  else{q={id:uid(),num:nextNum(S),example:false,estado:'borrador',pausa:false,enviado:null,seg:[],resuelto:null,motivo:'',nota:'',hist:[]};hist(q,'Borrador creado');S.quotes.unshift(q);}
  q.cliente=e.cliente.trim();q.telefono=e.telefono.trim();q.email=e.email.trim();q.titulo=e.titulo.trim();
  q.emision=e.emision;q.validez=e.validez;q.condiciones=e.condiciones.trim();q.notas=e.notas.trim();
  q.lineas=lines.map(function(l){return{desc:l.desc.trim(),qty:l.qty,price:l.price,disc:l.disc,iva:l.iva};});
  save();ed=null;
  toast('Borrador guardado');
  go(andSend?'det':'lista',andSend?q.id:null);
}

